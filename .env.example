# Copie para .env e preencha só na máquina que for operar.
# .env está no .gitignore. Nunca commite segredo.

# Confirmação obrigatória para QUALQUER ordem em conta real.
# Não defina isto até concluir o checklist de ida para live.
# DAYTRADE_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY

# --- B3: terminal MetaTrader 5 da corretora brasileira (Windows) ---
B3_MT5_LOGIN=
B3_MT5_PASSWORD=
